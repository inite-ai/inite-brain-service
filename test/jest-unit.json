{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testEnvironmentOptions": {
    "customExportConditions": ["node", "node-addons"]
  },
  "testRegex": ".*\\.unit-spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/.claude/worktrees/"],
  "modulePathIgnorePatterns": ["/.claude/worktrees/"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/"],
  "testTimeout": 30000,
  "cacheDirectory": "<rootDir>/.jest-cache",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.worker.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/dto/*.ts",
    "!src/db/migrations/**",
    "!src/**/*.d.ts"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 67,
      "branches": 55,
      "functions": 62,
      "lines": 68
    }
  },
  "setupFiles": ["<rootDir>/src/db/record-id-format.ts"]
}

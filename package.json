{
  "name": "inite-brain-service",
  "version": "2.5.0",
  "description": "INITE Brain Service - Cross-vertical knowledge layer (system of insight, not record). Implements the inite.service.brain contract.",
  "author": "INITE",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inite-ai/inite-brain-service.git"
  },
  "homepage": "https://brain.inite.ai",
  "bugs": {
    "url": "https://github.com/inite-ai/inite-brain-service/issues"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-unit.json",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-unit.json",
    "test:unit:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-unit.json --coverage",
    "test:socket": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-socket.json",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-unit.json --watch",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e.json",
    "test:e2e:real": "pnpm build && NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=brain.real",
    "test:e2e:jobs": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=jobs.real",
    "test:eval": "pnpm build && NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=quality",
    "eval:diff": "ts-node -r tsconfig-paths/register scripts/eval-baseline-diff.ts",
    "eval:memory-fitness": "ts-node -T test/eval/memory-fitness/runner.ts",
    "eval:state-transitions": "ts-node -T test/eval/state-transitions/runner.ts",
    "eval:relationship": "ts-node -T test/eval/relationship/runner.ts",
    "eval:domain-packs": "ts-node -T test/eval/domain-packs/runner.ts",
    "eval:code-memory": "ts-node -T test/eval/code-memory/runner.ts",
    "eval:evidence": "ts-node -T test/eval/evidence/runner.ts",
    "eval:transition-calibration": "ts-node -T test/eval/transition-calibration/runner.ts",
    "eval:multilingual": "ts-node -T test/eval/multilingual/runner.ts",
    "eval:conveyor": "ts-node -T test/eval/conveyor/runner.ts",
    "eval:halumem": "ts-node -T test/eval/halumem/runner.ts",
    "openapi:build": "ts-node -T scripts/build-openapi.ts",
    "migrations:flexible": "ts-node -T scripts/generate-flexible-reconcile.ts",
    "mri:report": "ts-node -T scripts/mri-report.ts",
    "mri:record-suite": "ts-node -T scripts/mri-record-suite.ts",
    "bench:router": "ts-node -r tsconfig-paths/register scripts/bench-chat-router.ts",
    "capture:decisions": "ts-node -r tsconfig-paths/register scripts/capture-decisions.ts",
    "label:decisions": "ts-node -r tsconfig-paths/register scripts/label-decisions.ts",
    "label:commitpackft": "ts-node -r tsconfig-paths/register scripts/label-commitpackft.ts",
    "train:decision-gate": "ts-node -r tsconfig-paths/register scripts/train-decision-gate.ts",
    "pack:init": "ts-node -r tsconfig-paths/register scripts/init-pack.ts",
    "pack:validate": "ts-node -r tsconfig-paths/register scripts/validate-pack.ts",
    "pack:install": "ts-node -r tsconfig-paths/register scripts/install-pack.ts",
    "pack:sign": "ts-node -r tsconfig-paths/register scripts/sign-pack.ts",
    "pack:publish": "ts-node -r tsconfig-paths/register scripts/publish-pack.ts",
    "pack:search": "ts-node -r tsconfig-paths/register scripts/search-registry.ts",
    "registry:seed": "ts-node -r tsconfig-paths/register scripts/seed-registry.ts",
    "indexer:reference": "ts-node -r tsconfig-paths/register examples/reference-indexer.ts",
    "indexer:repo": "ts-node -r tsconfig-paths/register scripts/index-repo.ts",
    "code-memory:validate-anchors": "ts-node -r tsconfig-paths/register scripts/validate-anchors.ts",
    "test:eval:fat": "pnpm build && FAT_TENANT_RUN=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=fat-tenant",
    "test:eval:directory": "pnpm build && DIRECTORY_RUN=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=directory",
    "test:eval:json": "pnpm build && NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=json-directory",
    "directory:fetch:wikidata": "ts-node -r tsconfig-paths/register scripts/fetch-wikidata-directory.ts",
    "test:eval:dreams": "pnpm build && DREAMS_E2E_RUN=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --config ./test/jest-e2e-real.json --runInBand --testPathPatterns=dreams.real",
    "skills:build": "ts-node -T scripts/build-skill-versions.ts",
    "skills:bump": "ts-node -T scripts/bump-skill-versions.ts --staged",
    "skills:pack": "pnpm skills:build && pnpm plugin:sync && ts-node -T scripts/package-skills.ts",
    "plugin:sync": "ts-node -T scripts/sync-plugin-skills.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@xenova/transformers": "^2.17.2",
    "any-ascii": "^0.3.3",
    "chrono-node": "^2.10.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compromise": "^14.19.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.43.0",
    "pdf2json": "4.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "surrealdb": "^2.1.1",
    "tesseract.js": "7.0.0",
    "yaml": "2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "protobufjs",
      "sharp",
      "onnxruntime-node"
    ],
    "overrides": {
      "sharp": "^0.35.5",
      "ws": "^8.21.0",
      "multer": "^2.5.0",
      "qs": "^6.16.0",
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5",
      "@grpc/grpc-js": "^1.14.5",
      "ip-address": "^10.3.1",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": "^2.9.0",
      "fast-uri": "^3.1.6",
      "body-parser": "^2.4.0",
      "form-data": "^4.0.6",
      "tmp": "^0.2.6",
      "js-yaml": "^4.3.2",
      "@babel/core": "^7.29.6",
      "undici": "^7.29.1",
      "minimatch@10": "^10.2.3",
      "uuid": "^11.1.1",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.7",
      "onnx-proto>protobufjs": "^7.6.5",
      "protobufjs@7": "^7.6.5",
      "protobufjs@8": "^8.6.6",
      "handlebars": "^4.7.10",
      "proxy-addr": "^2.0.8"
    }
  }
}

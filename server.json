{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.inite-ai/inite-brain-service",
  "title": "INITE Brain",
  "description": "Long-term memory for AI agents: a bitemporal knowledge graph with cited answers.",
  "version": "2.3.0",
  "websiteUrl": "https://brain.inite.ai",
  "repository": {
    "url": "https://github.com/inite-ai/inite-brain-service",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://brain.inite.ai/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://brain.inite.ai/mcp/{companyId}",
      "variables": {
        "companyId": {
          "description": "Tenant identifier issued at signup — scopes the memory graph to your company.",
          "isRequired": true
        }
      },
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API_KEY> — issued from the brain.inite.ai dashboard. Scoped to read / write / admin.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": 31,
      "scopes": [
        "read",
        "write",
        "admin"
      ],
      "backend": "surrealdb",
      "license": "AGPL-3.0",
      "benchmarks": [
        "LoCoMo"
      ],
      "auth": {
        "https://brain.inite.ai/mcp": "OAuth 2.0 (RFC 9728, DCR, PKCE) via https://auth-api.inite.ai",
        "https://brain.inite.ai/mcp/{companyId}": "Bearer API key"
      }
    }
  }
}

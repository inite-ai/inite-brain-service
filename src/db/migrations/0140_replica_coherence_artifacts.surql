-- 0140: admin artifacts move off the pod's disk, and job_run learns when
-- it was last written.
--
-- Two admin artifacts lived under a cwd-relative `var/` directory: the eval
-- baselines (`var/admin/baselines/<name>.json`, BaselineService) and the MRI
-- snapshot (`var/mri/latest.json`, MriService). With more than one replica a
-- baseline saved on pod A is invisible to pod B, and both writes fail on a
-- read-only root filesystem. They now live in the system database
-- (SurrealService.withAdminDb, database `system`), which every replica
-- shares. Nothing is migrated from disk: those files were runtime artifacts
-- of one process, regenerated by the next save / the next MRI request.
--
-- The payloads (`outcomes`, `report`) are stored as JSON strings on purpose.
-- They are opaque to the database — never filtered or projected by inner
-- field — and a `string` column cannot lose a FLEXIBLE clause on export /
-- re-import the way `option<object>` did (0134 / 0135).
--
-- `job_run.updatedAt` is the change marker the admin SSE stream polls: the
-- stream must show jobs that execute on another replica, and a
-- `VALUE time::now()` column is stamped by the database on every write of
-- the row, whichever process (or SurrealQL statement) performs it. Rows
-- written before this migration carry no updatedAt until their next write;
-- the stream only looks forward from the moment a client connects, so that
-- is enough.
--
-- Like leader_lease (0029) and tenant_registry (0104): the migrator applies
-- every file to every database, so the tenant-side copies of the two new
-- tables are defined but unused — the system-side copy is the active one.
-- Additive, IF NOT EXISTS throughout, no row touched.

DEFINE TABLE IF NOT EXISTS admin_baseline SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS name ON admin_baseline TYPE string;
DEFINE FIELD IF NOT EXISTS savedAt ON admin_baseline TYPE datetime DEFAULT time::now();
-- Denormalised from `outcomes` at save time so the list projection never
-- parses the payload.
DEFINE FIELD IF NOT EXISTS scenarios ON admin_baseline TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS meanRecallAt1 ON admin_baseline TYPE float DEFAULT 0;
-- JSON-encoded ScenarioRunOutcome[] (scenario-runner.types.ts).
DEFINE FIELD IF NOT EXISTS outcomes ON admin_baseline TYPE string;
DEFINE INDEX IF NOT EXISTS admin_baseline_name_idx ON admin_baseline FIELDS name UNIQUE;

DEFINE TABLE IF NOT EXISTS mri_snapshot SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS generatedAt ON mri_snapshot TYPE datetime;
-- JSON-encoded MriReport (mri.types.ts).
DEFINE FIELD IF NOT EXISTS report ON mri_snapshot TYPE string;
DEFINE FIELD IF NOT EXISTS updatedAt ON mri_snapshot TYPE datetime DEFAULT time::now();

DEFINE FIELD IF NOT EXISTS updatedAt ON job_run TYPE option<datetime> VALUE time::now();
DEFINE INDEX IF NOT EXISTS job_run_updated_idx ON job_run FIELDS updatedAt;

SURREALDB_URL=ws://localhost:18321
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=brain
# Bumped 8→16 for faster eval: agentic /v1/answer holds a pooled conn across
# its ReAct LLM calls, so QA concurrency is capped at pool size. 16 lets
# --qa-concurrency 16 run without queuing on the pool. Applied on next boot.
SURREALDB_POOL_SIZE=16
SURREALDB_SCOPED_POOL_SIZE=16
BRAIN_API_KEYS=[{"keyHash":"sha256:0c40b401c942f9d780fb9b930cffb73c1f3b5e840edeedc6cd3b3ff0b511aa9f","companyId":"co_loconooccur","scopes":["brain:read","brain:write","brain:read_pii","brain:admin"]}]
PORT=3030
INGEST_INLINE_RESOLUTION_ENABLED=0
THROTTLE_DISABLED=1
THROTTLE_LIMIT=1000000
THROTTLE_EXPENSIVE_LIMIT=1000000
INGEST_CONTEXTUAL_FACT_EMBEDDING=1
INGEST_EVENT_TIME_EXTRACTION=1
SEARCH_BACKFILL_PER_PREDICATE=3
SEARCH_FACTS_PER_ENTITY=20
EXTRACTOR_DROP_SAID=1
DIALOGUE_EPISODIC_ENABLED=0
# v3 stack under measurement (dev-5, fresh tenant co_locov3):
EXTRACTOR_DIALOGUE_PROFILE=1
INGEST_FACT_SENTENCE_EMBEDDING=0
INGEST_CONSOLIDATE_ENABLED=0
EXTRACTOR_OCCURRED_ON=0
